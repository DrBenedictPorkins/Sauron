ANTHROPIC_API_KEY=
SCAN_ROOTS=~/projects:Projects,~/dev:Dev
CLAUDE_MODEL=claude-haiku-4-5
HOST=127.0.0.1
PORT=7777
ACTIVE_CUTOFF_DAYS=30
MAX_SUMMARIES_PER_SCAN=50
IGNORE_PATHS=

# Per-million-token pricing — MUST match CLAUDE_MODEL or the in-app cost meter lies.
# Defaults below are for claude-haiku-4-5. Sonnet 4.6 is 3.00 / 15.00.
PRICE_INPUT_MTOK=0.80
PRICE_OUTPUT_MTOK=4.00
