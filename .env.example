ANTHROPIC_API_KEY=
SCAN_ROOTS=~/projects:Projects,~/dev:Dev
CLAUDE_MODEL=claude-haiku-5-5
HOST=127.0.0.1
PORT=7777
ACTIVE_CUTOFF_DAYS=30
MAX_SUMMARIES_PER_SCAN=50
IGNORE_PATHS=

# Per-million-token pricing. src/models.js holds a price table keyed by CLAUDE_MODEL;
# set these only to override it (a repriced model, or one not in the table).
# If neither the table nor these vars can price CLAUDE_MODEL, the server refuses to
# start — a wrong cost meter is worse than no server.
# PRICE_INPUT_MTOK=
# PRICE_OUTPUT_MTOK=
